# Example variable names only. Never commit real credentials.

# Android release signing
MSA_ANDROID_KEYSTORE_PATH=/absolute/path/to/msa-release.jks
MSA_ANDROID_STORE_PASSWORD=<REDACTED>
MSA_ANDROID_KEY_ALIAS=<REDACTED>
MSA_ANDROID_KEY_PASSWORD=<REDACTED>

# GitHub Actions Android secret containing the base64-encoded keystore
MSA_ANDROID_KEYSTORE_BASE64=<REDACTED>

# iOS local/Xcode signing and optional signed-archive workflow
MSA_IOS_TEAM_ID=<APPLE_TEAM_ID>
MSA_IOS_SIGNING_IDENTITY=<APPLE_DISTRIBUTION_IDENTITY>
MSA_IOS_PROVISIONING_PROFILE_SPECIFIER=<APP_STORE_PROFILE_NAME>
MSA_IOS_CERTIFICATE_BASE64=<REDACTED>
MSA_IOS_CERTIFICATE_PASSWORD=<REDACTED>
MSA_IOS_PROVISIONING_PROFILE_BASE64=<REDACTED>

# Optional desktop accessibility override
# JAVA_TOOL_OPTIONS=-Dmsa.bee.reduceMotion=true
